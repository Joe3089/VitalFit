FROM golang:1.25-alpine AS development


RUN apk add --no-cache git make
RUN go install -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate@v4.18.3

RUN go install github.com/air-verse/air@v1.61.7

RUN go install github.com/swaggo/swag/cmd/swag@v1.16.6

WORKDIR /app

COPY .air.toml go.mod go.sum ./

RUN go mod download

COPY . .

EXPOSE 8080

#builder stage
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache ca-certificates git

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN go install github.com/swaggo/swag/cmd/swag@v1.16.6
RUN swag init -g ./api/main.go -d cmd,internal && swag fmt

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/main ./cmd/api
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/seed ./internal/migrate/seed

RUN go install -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate@v4.18.3

#production stage
FROM alpine:latest AS production

RUN apk --no-cache add ca-certificates
RUN apk --no-cache add postgresql-client

WORKDIR /app

COPY --from=builder /app/main .

COPY --from=builder /go/bin/migrate .

COPY ./internal/migrate/migrations ./migrations

COPY --from=builder /app/docs ./docs

COPY ./scripts/start.sh ./start.sh

# One-off data seed (enabled with SEED_ON_START=true, see start.sh)
COPY --from=builder /app/seed .
COPY ./internal/migrate/seed/data ./internal/migrate/seed/data

EXPOSE 8080

CMD ["sh", "./start.sh"]
